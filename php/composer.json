{
    "name": "apiverve/textembeddings",
    "description": "Text Embeddings turns a sentence, paragraph or short document into a 384-dimension vector that captures its meaning, ready for semantic search, clustering, deduplication and recommendations. Send one text or a batch of up to 32, and add a compare text to get the cosine similarity of each one to it in the same call.",
    "version": "1.2.6",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "textembeddings",
        "text embeddings api",
        "sentence embeddings api",
        "embedding api",
        "vector embeddings",
        "semantic search api"
    ],
    "homepage": "https://apiverve.com/marketplace/textembeddings?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/textembeddings",
        "source": "https://github.com/apiverve/textembeddings-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Textembeddings\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Textembeddings\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
